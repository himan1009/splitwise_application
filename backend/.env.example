# Copy to .env and fill in real values. Never commit .env.

MONGO_URI=mongodb://127.0.0.1:27017/fintrack
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=5000

# Comma-separated origins for production CORS (e.g. https://yourapp.com)
ALLOWED_ORIGINS=http://localhost:5173

# Email verification — pick ONE option below
FRONTEND_URL=http://localhost:5173

# Option A (recommended for Render FREE tier): Brevo HTTP API
# Render blocks Gmail SMTP ports 587/465 on free tier — use Brevo instead.
# 1. Sign up at https://www.brevo.com (free, 300 emails/day)
# 2. Senders → Add sender → verify your Gmail (one-time click in inbox)
# 3. SMTP & API → Generate API key
BREVO_API_KEY=xkeysib_your_api_key_here
BREVO_SENDER_EMAIL=yourname@gmail.com
BREVO_SENDER_NAME=FinTrack

# Option B: Gmail SMTP — works on localhost or PAID Render only (NOT free Render)
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your_16_char_app_password
# EMAIL_FROM=FinTrack <yourname@gmail.com>

# Option C: Resend — needs verified custom domain to email anyone
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=FinTrack <noreply@mail.yourdomain.com>
