# Copy to .env and fill in real values. Never commit .env.

MONGO_URI=mongodb://127.0.0.1:27017/fintrack
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=5000

# Comma-separated origins for production CORS (e.g. https://yourapp.com)
ALLOWED_ORIGINS=http://localhost:5173

# Email verification — pick ONE option below
FRONTEND_URL=http://localhost:5173

# Option A (recommended, no domain): Gmail SMTP — sends to ANY user's email
# 1. Turn on 2-Step Verification on your Google account
# 2. Google Account → Security → App passwords → create one for "Mail"
# 3. Use that 16-char password as SMTP_PASS (not your normal Gmail password)
SMTP_USER=yourname@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=FinTrack <yourname@gmail.com>

# Option B: Resend — only sends to anyone AFTER you verify a custom domain
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=FinTrack <noreply@mail.yourdomain.com>
